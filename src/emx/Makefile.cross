SUBDIRS := libcrossemx libomflib libmoddef emxexp emximp emxbind ld emxomf

SRCDIR := src
MAKEFILE_CROSS := Makefile.cross

PREFIXROOT ?= $(HOME)
OS2EMX_PREFIX ?= /data/os2emx

.PHONY: all build clean install

all: build

build:
	for d in $(SUBDIRS); do \
	  $(MAKE) -C $(SRCDIR)/$$d -f $(MAKEFILE_CROSS) || exit 1; \
	done

clean:
	for d in $(SUBDIRS); do \
	  $(MAKE) -C $(SRCDIR)/$$d -f $(MAKEFILE_CROSS) clean || exit 1; \
	done

install: build
	for d in $(SUBDIRS); do \
	  $(MAKE) -C $(SRCDIR)/$$d -f $(MAKEFILE_CROSS) install \
	    DESTDIR=$(DESTDIR) PREFIXROOT=$(PREFIXROOT) OS2EMX_PREFIX=$(OS2EMX_PREFIX) || exit 1; \
	done
